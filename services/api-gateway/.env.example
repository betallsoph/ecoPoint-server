PORT=4000

USER_SERVICE_URL=http://localhost:50051
POINT_SERVICE_URL=http://localhost:50053

# JWT_SECRET phải GIỐNG HỆT với user-service (cùng cụm/môi trường).
# Validation chính chạy qua gRPC sang user-service; secret ở đây để verify local
# (fallback hoặc lưu cho consistency hạ tầng) nếu cần.
JWT_SECRET=replace-with-strong-random-secret-min-256-bits
