GRPC_PORT=50051
DATABASE_URL=postgres://ecopoint:ecopoint_secret@localhost:5432/db_user

# ===== JWT =====
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# KHÔNG dùng giá trị mẫu này ngoài đời thực — sinh ngẫu nhiên mỗi môi trường.
JWT_SECRET=replace-with-strong-random-secret-min-256-bits
JWT_ALGORITHM=HS256
JWT_ISSUER=ecopoint
JWT_EXPIRES_IN=7d
